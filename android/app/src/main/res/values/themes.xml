<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SportsDash" parent="android:Theme.Material.NoActionBar">
        <!-- Status draws edge-to-edge; nav bar solid so Back/Home/Recents stay familiar. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/void_black</item>
        <item name="android:windowBackground">@color/void_black</item>
        <item name="android:colorPrimary">@color/gold</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">true</item>
        <item name="android:navigationBarDividerColor">@color/void_black</item>
    </style>
</resources>
